###############################################################################
# terraform.tfvars.example
# Copy this file to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars to version control.
###############################################################################

aws_region          = "us-east-1"
environment         = "dev"
project_name        = "travelmemory"
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"
private_subnet_cidr = "10.0.2.0/24"

# Replace with your actual public IP: curl ifconfig.me
operator_ip_cidr = "203.0.113.5/32"

# Path to your SSH public key
public_key_path = "~/.ssh/id_rsa.pub"

# Instance sizes  (t3.micro for free tier testing)
web_instance_type = "t3.small"
db_instance_type  = "t3.small"
